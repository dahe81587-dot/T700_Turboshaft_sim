<?xml version="1.0" encoding="utf-8"?>
<chart id="21">
  <P Name="name">While Iterator
Subsystem/Plantmodel/BleedSchedule/MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">21</P>
  <P Name="ssIdHighWaterMark">19</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">bleed_schedule</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">21</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [beta,coord,inRange] = bleed_schedule( ...
    W2,T2,P2,Ng,x1,y1,x2,y2,x3,y3,ref,Kbl,Kb3)
%#codegen

% ref = [参考温度; 参考压力; 设计Ng]
theta = T2/ref(1);
delta = P2/ref(2);

% 当前状态对应的修正量
Wc = W2*sqrt(theta)/delta;
NGcPercent = 100*Ng/(ref(3)*sqrt(theta));

% 未截断坐标，用于检查最终工作点是否越界
coord = [NGcPercent; Wc];

inRange = ...
    NGcPercent &gt;= x1(1) &amp;&amp; NGcPercent &lt;= x1(end) &amp;&amp; ...
    Wc &gt;= x2(1) &amp;&amp; Wc &lt;= x2(end) &amp;&amp; ...
    Wc &gt;= x3(1) &amp;&amp; Wc &lt;= x3(end);

% 求解过程中的越界试算使用端点值
q1 = min(max(NGcPercent,x1(1)),x1(end));
q2 = min(max(Wc,x2(1)),x2(end));
q3 = min(max(Wc,x3(1)),x3(end));

B1 = interp1(x1,y1,q1,&apos;linear&apos;);
B2 = interp1(x2,y2,q2,&apos;linear&apos;);
B3 = interp1(x3,y3,q3,&apos;linear&apos;);

% 三个模型引气通道：前两路排出，第三路回流
beta = [B1+B2;
        B3*(1-Kbl)+Kb3;
        B3*Kbl];
end</P>
      </eml>
    </state>
    <data SSID="4" name="W2">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="beta">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
