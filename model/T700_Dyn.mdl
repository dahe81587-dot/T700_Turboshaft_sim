    <P Name="ZOrder">879</P>
    <P Name="AncestorBlock">Lib_Turbo_Compressor_TMATS/Compressor</P>
    <P Name="LibraryVersion">*14.0</P>
    <Mask SelfModifiable="on">
      <Type>T-MATS: Compressor Library Block</Type>
      <Display/>
      <Description>This block simulates the performance of a compressor using basic thermodynamic equations, properties, and table lookups.</Description>
      <Initialization>MSK_CompInit_TMATS</Initialization>
      <Help>web(which(&apos;Turbo_TMATS_Cmp.html&apos;),&apos;-helpbrowser&apos;)</Help>
      <MaskParameter Name="X_C_RlineVec_M" Type="edit">
        <Prompt>X_C_RlineVec_M - Compressor Map Rline Vector (X-axis)(nx1)</Prompt>
        <Value>MWS.Compressor.RlineVec</Value>
      </MaskParameter>
      <MaskParameter Name="Z_C_AlphaVec_M" Type="edit" Visible="off">
        <Prompt>Z_C_Map_AlphaVec_M - Compressor Alpha Vector (Z-axis)(rx1)</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="Y_C_Map_NcVec_M" Type="edit">
        <Prompt>Y_C_Map_NcVec_M - Compressor Map Corrected Speed Vector (Y-axis)(mx1)</Prompt>
        <Value>MWS.Compressor.NcVec</Value>
      </MaskParameter>
      <MaskParameter Name="T_C_Map_WcArray_M" Type="edit">
        <Prompt>T_C_Map_WcArray_M - Compressor Map Flow Array (Wc = f(Nc, Rline))(mxn)</Prompt>
        <Value>MWS.Compressor.WcArray</Value>
      </MaskParameter>
      <MaskParameter Name="T_C_Map_PRArray_M" Type="edit">
        <Prompt>T_C_Map_PRArray_M - Compressor Map Pressure Ratio Array (PR = f(Nc, Rline))(mxn)</Prompt>
        <Value>MWS.Compressor.PRArray</Value>
      </MaskParameter>
      <MaskParameter Name="T_C_Map_EffArray_M" Type="edit">
        <Prompt>T_C_Map_EffArray_M - Compressor Map Efficiency Array (Eff = f(Nc, Rline)(mxn)</Prompt>
        <Value>MWS.Compressor.EffArray</Value>
      </MaskParameter>
      <MaskParameter Name="s_C_Nc_M" Type="edit">
        <Prompt>s_C_Nc_M - Corrected Speed Scalar Constant (C_Nc)</Prompt>
        <Value>MWS.Compressor.s_Nc</Value>
      </MaskParameter>
      <MaskParameter Name="s_C_Wc_M" Type="edit">
        <Prompt>s_C_Wc_M - Flow Scalar Constant (C_Wc)</Prompt>
        <Value>MWS.Compressor.s_Wc</Value>
      </MaskParameter>
      <MaskParameter Name="s_C_PR_M" Type="edit">
        <Prompt>s_C_PR_M - Pressure Ratio Scalar Constant (C_PR)</Prompt>
        <Value>MWS.Compressor.s_PR</Value>
      </MaskParameter>
      <MaskParameter Name="s_C_Eff_M" Type="edit">
        <Prompt>s_C_Eff_M - Efficiency Scalar Constant (C_Eff)</Prompt>
        <Value>MWS.Compressor.s_eff</Value>
      </MaskParameter>
      <MaskParameter Name="SL_M" Type="checkbox">
        <Prompt>Include surge line</Prompt>
        <Value>off</Value>
      </MaskParameter>
      <MaskParameter Name="Scale_M" Type="radiobutton">
        <Prompt>Scalars</Prompt>
        <Value>none</Value>
        <TypeOptions>
          <Option>none</Option>
          <Option>user defined</Option>
          <Option>iDesign</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="CBLDEN_M" Type="checkbox">
        <Prompt>CBLDEN_M - Customer Bleed Enable [0 - off, 1 - on]</Prompt>
        <Value>off</Value>
        <Callback>MSK_SEC_Enables_TMATS(&apos;CBLDEN_M&apos;,[14 15 16],&apos;en&apos;)
</Callback>
      </MaskParameter>
      <MaskParameter Name="C_CBD_M" Type="edit" Enabled="off">
        <Prompt>C_CBD_M - Customer or Flow based Bleed Demand[pps] (cbx1)</Prompt>
        <Value>0</Value>
      </MaskParameter>
      <MaskParameter Name="C_CBFht_M" Type="edit" Enabled="off">
        <Prompt>C_CBFht_M - Customer or Flow based Bleed Fractional enthalpy[frac] (cbx1)</Prompt>
        <Value>0.5</Value>
      </MaskParameter>
      <MaskParameter Name="C_CBFPt_M" Type="edit" Enabled="off">
        <Prompt>C_CBFPt_M - Customer or Flow based Bleed Fractional Total Pressure[frac] (cbx1)</Prompt>
        <Value>0.5</Value>
      </MaskParameter>
      <MaskParameter Name="FBLDEN_M" Type="checkbox">
        <Prompt>FBLDEN_M - Fractional Bleed Enable [0 - off, 1 - on]</Prompt>
        <Value>on</Value>
        <Callback>MSK_SEC_Enables_TMATS(&apos;FBLDEN_M&apos;,[18 19 20],&apos;en&apos;)</Callback>
      </MaskParameter>
      <MaskParameter Name="C_FBD_M" Type="edit">
        <Prompt>C_FBD_M - Fractional Bleed Demand[frac] (bx1)</Prompt>
        <Value>MWS.Compressor.BleedFractions</Value>
      </MaskParameter>
      <MaskParameter Name="C_BFht_M" Type="edit">
        <Prompt>C_BFht_M - Engine Bleed Fractional Enthalpy[frac] (bx1)</Prompt>
        <Value>MWS.Compressor.BleedEnthalpyFractions</Value>
      </MaskParameter>
      <MaskParameter Name="C_BFPt_M" Type="edit">
        <Prompt>C_BFPt_M - Engine Bleed Fractional Total Pressure[frac] (bx1)</Prompt>
        <Value>MWS.Compressor.BleedPressureFractions</Value>
      </MaskParameter>
      <MaskParameter Name="DefSMEn_M" Type="checkbox">
        <Prompt>DefSMEn_M - Use map default (Rline = 1) surge line</Prompt>
        <Value>off</Value>
        <Callback>MSK_SEC_Enables_TMATS(&apos;DefSMEn_M&apos;,[24 25],&apos;dis&apos;)
MSK_SEC_Enables_TMATS(&apos;DefSMEn_M&apos;,[23],&apos;en&apos;)</Callback>
      </MaskParameter>
      <MaskParameter Name="SMNEn_M" Type="checkbox">
        <Prompt>SMNEn_M - Use constant Nc-based instead of constant Wc-based surge margin calculation</Prompt>
        <Value>off</Value>
      </MaskParameter>
      <MaskParameter Name="SRline_M" Type="edit" Enabled="off">
        <Prompt>SRline_M - Rline defined as surge line</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="X_C_Map_WcSurgeVec_M" Type="edit">
        <Prompt>X_C_Map_WcSurgeVec_M - map Compensated flow surge vector (sx1)</Prompt>
        <Value>MWS.Compressor.WcMapSurge</Value>
      </MaskParameter>
      <MaskParameter Name="T_C_Map_PRSurgeVec_M" Type="edit">
        <Prompt>T_C_Map_PRSurgeVec_M - map Surge Line Pressure Ratio vector (sx1)</Prompt>
        <Value>MWS.Compressor.PRMapSurge</Value>
      </MaskParameter>
      <MaskParameter Name="iDesign_M" Type="edit">
        <Prompt>iDesign_M - Design fork (0 - Enable iDes, 1 - Use iDes Scalars, 2 - Use Specified Input Scalars)</Prompt>
        <Value>2</Value>
        <Callback>MSK_SEC_Enables_Ides_TMATS(&apos;iDesign_M&apos;,[7 8 9 10],&apos;G1&apos;)
MSK_SEC_Enables_Ides_TMATS(&apos;iDesign_M&apos;,[27 28 29 30],&apos;G2&apos;)
MSK_SEC_Enables_Ides_TMATS(&apos;iDesign_M&apos;,[31],&apos;G3&apos;)
</Callback>
      </MaskParameter>
      <MaskParameter Name="NcDes_M" Type="edit" Enabled="off">
        <Prompt>NcDes_M - map Design Corrected Shaft Speed [rpm]</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="EffDes_M" Type="edit" Enabled="off">
        <Prompt>EffDes_M  - Design Efficiency [frac]</Prompt>
        <Value>0.85</Value>
      </MaskParameter>
      <MaskParameter Name="PRDes_M" Type="edit" Enabled="off">
        <Prompt>PRDes_M - Design Pressure Ratio [frac]</Prompt>
        <Value>20</Value>
      </MaskParameter>
      <MaskParameter Name="RlineDes_M" Type="edit" Enabled="off">
        <Prompt>RlineDes_M - map Design Rline</Prompt>
        <Value>2</Value>
      </MaskParameter>
      <MaskParameter Name="FVar_M" Type="edit" Tunable="off" Enabled="off">
        <Prompt>FVar_M - File name for iDes Variables</Prompt>
        <Value>strcat(&apos;iDes_&apos;,stripchar_TMATS(gcb),&apos;.bin&apos;)</Value>
      </MaskParameter>
      <MaskParameter Name="BlkNm_M" Type="edit" Tunable="off" Internal="on" Visible="off">
        <Prompt>Block name as double for Simulink output</Prompt>
        <Value>double(gcb)</Value>
      </MaskParameter>
      <MaskParameter Name="HP_M" Type="checkbox">
        <Prompt>HP_M - Enable Health Parameter input (3x1 vector)</Prompt>
        <Value>off</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="TabContainer" Name="ParameterTabContainerVar">
        <DialogControl Type="Tab" Name="ParameterTabVar0">
          <Prompt>C-Map</Prompt>
          <DialogControl Type="Edit" Name="X_C_RlineVec_M">
            <Prompt>X_C_RlineVec_M - Compressor Map Rline Vector (X-axis)(nx1)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="Z_C_AlphaVec_M">
            <Prompt>Z_C_Map_AlphaVec_M - Compressor Alpha Vector (Z-axis)(rx1)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="Y_C_Map_NcVec_M">
            <Prompt>Y_C_Map_NcVec_M - Compressor Map Corrected Speed Vector (Y-axis)(mx1)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="T_C_Map_WcArray_M">
            <Prompt>T_C_Map_WcArray_M - Compressor Map Flow Array (Wc = f(Nc, Rline))(mxn)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="T_C_Map_PRArray_M">
            <Prompt>T_C_Map_PRArray_M - Compressor Map Pressure Ratio Array (PR = f(Nc, Rline))(mxn)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="T_C_Map_EffArray_M">
            <Prompt>T_C_Map_EffArray_M - Compressor Map Efficiency Array (Eff = f(Nc, Rline)(mxn)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="s_C_Nc_M">
            <Prompt>s_C_Nc_M - Corrected Speed Scalar Constant (C_Nc)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="s_C_Wc_M">
            <Prompt>s_C_Wc_M - Flow Scalar Constant (C_Wc)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="s_C_PR_M">
            <Prompt>s_C_PR_M - Pressure Ratio Scalar Constant (C_PR)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="s_C_Eff_M">
