          </DialogControl>
          <DialogControl Type="Edit" Name="SRline_M">
            <Prompt>SRline_M - Rline defined as surge line</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="X_C_Map_WcSurgeVec_M">
