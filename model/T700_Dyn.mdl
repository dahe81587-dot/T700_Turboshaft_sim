              <Prompt>Include surge line</Prompt>
              <ControlOptions Row="current"/>
            </DialogControl>
            <DialogControl Type="RadioButton" Name="Scale_M">
              <Prompt>Scalars</Prompt>
              <ControlOptions Row="current" Orientation="vertical"/>
            </DialogControl>
          </DialogControl>
        </DialogControl>
        <DialogControl Type="Tab" Name="ParameterTabVar01">
          <Prompt>Bleeds</Prompt>
          <DialogControl Type="CheckBox" Name="CBLDEN_M">
            <Prompt>CBLDEN_M - Customer Bleed Enable [0 - off, 1 - on]</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="C_CBD_M">
            <Prompt>C_CBD_M - Customer or Flow based Bleed Demand[pps] (cbx1)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="C_CBFht_M">
            <Prompt>C_CBFht_M - Customer or Flow based Bleed Fractional enthalpy[frac] (cbx1)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="C_CBFPt_M">
            <Prompt>C_CBFPt_M - Customer or Flow based Bleed Fractional Total Pressure[frac] (cbx1)</Prompt>
          </DialogControl>
          <DialogControl Type="CheckBox" Name="FBLDEN_M">
            <Prompt>FBLDEN_M - Fractional Bleed Enable [0 - off, 1 - on]</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="C_FBD_M">
            <Prompt>C_FBD_M - Fractional Bleed Demand[frac] (bx1)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="C_BFht_M">
            <Prompt>C_BFht_M - Engine Bleed Fractional Enthalpy[frac] (bx1)</Prompt>
          </DialogControl>
          <DialogControl Type="Edit" Name="C_BFPt_M">
            <Prompt>C_BFPt_M - Engine Bleed Fractional Total Pressure[frac] (bx1)</Prompt>
          </DialogControl>
        </DialogControl>
        <DialogControl Type="Tab" Name="ParameterTabVar012">
          <Prompt>Surge Margin</Prompt>
          <DialogControl Type="CheckBox" Name="DefSMEn_M">
            <Prompt>DefSMEn_M - Use map default (Rline = 1) surge line</Prompt>
          </DialogControl>
          <DialogControl Type="CheckBox" Name="SMNEn_M">
